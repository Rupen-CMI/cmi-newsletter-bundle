# Copy to .env and fill in. NEVER commit the real .env -- it holds live credentials.
#   cp .env.example .env

# ── LLM ───────────────────────────────────────────────────────────────────────
# 'local' routes every call to our fine-tune. Nothing goes to DeepSeek or OpenAI.
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=https://<vllm-host>/v1
LOCAL_LLM_MODEL=cmi-7b
LOCAL_LLM_API_KEY=local

# ── Mail ──────────────────────────────────────────────────────────────────────
# SendGrid is used automatically whenever SENDGRID_WEB_API is set; SMTP is the
# fallback. Force one with CMI_MAIL_PROVIDER=sendgrid|smtp.
SENDGRID_WEB_API=
SENDER_EMAIL=aditya@coherentmarketinsights.info
SENDER_NAME=Coherent Market Insights

# SMTP fallback. Raw Gmail SMTP from an unauthenticated domain bounced ~40% on
# 2026-09-16 (550 5.4.1 from Outlook/M365), so this path stays gated behind
# CMI_SENDING_DISABLED until SPF/DKIM/DMARC are fixed for the sending domain.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CMI_SENDING_DISABLED=1

# ── Optional ──────────────────────────────────────────────────────────────────
CMI_UNSUB_URL=https://www.coherentmarketinsights.com/contact-us
CMI_LLM_VALIDATE=1      # run the fine-tune as a judge over its own output
CMI_LLM_STRICT=0        # 1 = role findings BLOCK the send instead of warning
