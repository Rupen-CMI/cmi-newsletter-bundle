# Live credentials. .env.example is the template that IS committed.
.env

__pycache__/
*.pyc
*.log
logs/

# Virtualenvs / local tool caches
venv/
.venv/
.pytest_cache/

# Generated briefs -- reproducible, and they contain recipient names.
output*/
!sample_output/
validate_tmp_report/

# Local database. Ships once with the bundle; do not track further changes.
*.db-journal
*.db-wal
*.db-shm
*.db

# LoRA adapter weights -- 300MB+, exceeds GitHub's file size limits. Lives on disk
# for local use (uploaded to a GPU instance for merging) but is never committed.
training_data/adapter/*.bin
training_data/adapter/*.safetensors

# Per-run send/validate artifacts -- reproducible, recipient-identifying, or scratch scripts.
send_ids_*.json
send_ids_run*.json
validate_ids_*.json
brief_check_*.txt
token_usage.jsonl
validate_tmp_report/*
session_scratch/*

# One-off audit notes, not part of the shipped codebase.
PIPELINE_AUDIT.md

# DB backups taken before migrations (contain lead data).
*.db.bak*

# Fine-tune adapter weights and share bundles (300MB+ each).
training_data/*adapter*/*.safetensors
v4_adapter_share/
v4_adapter_share.zip

# Raw lead exports and locally generated sample briefs (recipient-identifying).
leads_export_*.csv
qwen35_9b_finetune_briefs/

# Stock Qwen3.5 tokenizer (20MB, identical across adapters; ships with the base model).
training_data/v*_adapter*/tokenizer.json
# Answer key for the blind review sheet -- keep it out of the reviewer's checkout.
training_data/v4/REVIEW_KEY_DO_NOT_OPEN.csv

# Local-only: Claude Code settings and a personal email signature.
.claude/
raj.html
